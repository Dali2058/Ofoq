# ===== مزوّد الذكاء الاصطناعي (أي واجهة متوافقة مع OpenAI) =====
# الافتراضي: Google Gemini عبر Google AI Studio (فيه طبقة مجانية)
# المفتاح من: https://aistudio.google.com/apikey
AI_API_KEY=2e63a2902046adf0cee42c9043383010
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash

# بدائل مجانية (غيّر القيم الثلاث فوق):
# Groq:       AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=<موديل ينتهي بـ :free>

# ===== البحث على الإنترنت (اختياري) =====
# بدون مفتاح هيستخدم DuckDuckGo كحل احتياطي. Tavily أدق وفيه طبقة مجانية: https://tavily.com
TAVILY_API_KEY=

# ===== الخادم =====
PORT=3000
NODE_ENV=development
# سر توقيع الجلسات. لو فاضي بيتولّد تلقائيًا ويتحفظ في data/jwt.secret
JWT_SECRET=
